{
  "name": "obsidian-topic-stream-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "api:generate": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "check": "pnpm api:check && pnpm typecheck && pnpm lint && pnpm test:mobile && pnpm test",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test": "vitest run --project unit",
    "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "test:storybook": "vitest run --project storybook",
    "browser:install": "node scripts/install-browser.mjs",
    "test:e2e": "pnpm build && wdio run wdio.conf.mjs",
    "test:e2e:headless": "node scripts/run-e2e-headless.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.0",
    "dompurify": "3.4.17",
    "mdast-util-from-markdown": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@eslint/json": "0.14.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.3",
    "mocha": "10.8.2",
    "obsidian": "1.8.7",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "storybook": "10.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.2",
    "wdio-obsidian-service": "3.3.0",
    "webdriverio": "9.32.0"
  }
}
