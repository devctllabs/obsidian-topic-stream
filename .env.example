TOPIC_STREAM_BACKEND_IMAGE=ghcr.io/ethernity/obsidian-topic-stream:latest
TOPIC_STREAM_BOOTSTRAP_EMBEDDING_DIMENSIONS=1024
TOPIC_STREAM_BOOTSTRAP_EMBEDDING_ENDPOINT=http://localhost:11434/v1
TOPIC_STREAM_BOOTSTRAP_EMBEDDING_MODEL=qwen3-embedding:0.6b
TOPIC_STREAM_COMPOSE_DB_PRIMARY_POSTGRES_DSN=postgres://topic_stream:topic_stream@postgres:5432/topic_stream?sslmode=disable
TOPIC_STREAM_COMPOSE_HTTP_ADDR=0.0.0.0:7331
TOPIC_STREAM_COMPOSE_QDRANT_URL=http://qdrant:6334
TOPIC_STREAM_CORS_ALLOWED_ORIGINS=app://obsidian.md
TOPIC_STREAM_DB_PRIMARY_KIND=postgres
TOPIC_STREAM_DB_PRIMARY_POSTGRES_DSN=
TOPIC_STREAM_EMBEDDING_BATCH_INPUT_BYTES=1048576
TOPIC_STREAM_EMBEDDING_BATCH_SIZE=8
TOPIC_STREAM_EMBEDDING_CONCURRENCY=1
TOPIC_STREAM_HEALTH_ADDR=:8081
TOPIC_STREAM_HEALTH_SERVER_ENABLED=true
TOPIC_STREAM_HTTP_ADDR=127.0.0.1:7331
TOPIC_STREAM_HTTP_SERVER_ENABLED=true
TOPIC_STREAM_LOG_LEVEL=info
TOPIC_STREAM_POSTGRES_DB=topic_stream
TOPIC_STREAM_POSTGRES_PASSWORD=topic_stream
TOPIC_STREAM_POSTGRES_USER=topic_stream
TOPIC_STREAM_QDRANT_ACORN_ENABLED=true
TOPIC_STREAM_QDRANT_ACORN_MAX_SELECTIVITY_PERCENT=40
TOPIC_STREAM_QDRANT_FULL_SCAN_THRESHOLD_KB=100000
TOPIC_STREAM_QDRANT_HNSW_EF=256
TOPIC_STREAM_QDRANT_URL=http://127.0.0.1:6334
TOPIC_STREAM_SCHEDULERS_ENABLED=true
TOPIC_STREAM_SHUTDOWN_TIMEOUT=10s
TOPIC_STREAM_WORKERS_ENABLED=true
TOPIC_STREAM_WORKER_FEED_PREPARATION_CONCURRENCY=2
TOPIC_STREAM_WORKER_FETCH_CONCURRENCY=4
TOPIC_STREAM_WORKER_FETCH_PER_HOST_CONCURRENCY=1
TOPIC_STREAM_WORKER_GENERATION_CONCURRENCY=1
TOPIC_STREAM_WORKER_MAINTENANCE_CONCURRENCY=1
TOPIC_STREAM_WORKER_RETRIEVAL_CONCURRENCY=2
TOPIC_STREAM_WORKSPACE_ID=
